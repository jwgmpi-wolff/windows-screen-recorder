<Window x:Class="PortableScreenRecorder.App.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" Cursor="Cross" WindowStartupLocation="Manual"
        KeyDown="OnKeyDown" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
    <Grid x:Name="Surface">
        <Path x:Name="DimPath" Fill="#99000000"/>
        <Border x:Name="SelectionBorder" BorderBrush="#FF5252" BorderThickness="2" Background="#11000000"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Border x:Name="InfoPanel" Background="#E620242A" CornerRadius="4" Padding="10" HorizontalAlignment="Left"
                VerticalAlignment="Top" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="DimensionsText" Foreground="White" FontWeight="SemiBold"/>
                <StackPanel x:Name="ConfirmationPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <Button Content="Use Region" Click="OnConfirm" Padding="10,5" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Click="OnCancel" Padding="10,5"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="Drag to select a recording region. Enter confirms; Escape cancels."
                   Foreground="White" Background="#CC20242A" Padding="12,8"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>
    </Grid>
</Window>
