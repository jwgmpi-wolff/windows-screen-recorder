<Window x:Class="PortableScreenRecorder.App.SpeechToTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speech to Text and Copilot" Icon="Assets/AppIcon.ico"
        Width="760" Height="720" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top" Background="#20242A" CornerRadius="6" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Local Speech to Text" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="System and mixed audio use local Whisper. Speech stays on this computer."
                           Foreground="#C8CDD3" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#FFF4E5" BorderBrush="#FFD08A" BorderThickness="1"
                CornerRadius="4" Padding="9" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Expander IsExpanded="False" Margin="0,0,0,10">
                    <Expander.Header>
                        <TextBlock Text="Speech recognition controls" FontSize="15" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="20,8,4,4">
                        <TextBlock Text="Recognition language"/>
                        <ComboBox ItemsSource="{Binding Recognizers}" SelectedItem="{Binding SelectedRecognizer}"
                                  DisplayMemberPath="Label" Margin="0,4,0,8" MinHeight="30"/>
                        <TextBlock Text="{Binding MinimumConfidence, StringFormat=Minimum confidence: {0:P0}}"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding MinimumConfidence}" Margin="0,3,0,10"/>
                        <WrapPanel>
                            <Button Content="Start Listening" Command="{Binding StartCommand}" Padding="12,6" Margin="0,0,8,8"/>
                            <Button Content="Stop" Command="{Binding StopCommand}" Padding="12,6" Margin="0,0,8,8"/>
                            <Button Content="Clear" Command="{Binding ClearCommand}" Padding="12,6" Margin="0,0,8,8"/>
                            <Button Content="Copy" Command="{Binding CopyCommand}" Padding="12,6" Margin="0,0,8,8"/>
                            <Button Content="Save TXT + SRT" Command="{Binding SaveCommand}" Padding="12,6" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <Expander IsExpanded="True" Margin="0,0,0,10">
                    <Expander.Header>
                        <TextBlock Text="Transcript" FontSize="15" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="20,8,4,4">
                        <TextBox Text="{Binding DisplayedTranscript}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="190" VerticalScrollBarVisibility="Auto"
                                 Padding="10" FontSize="15"
                                 AutomationProperties.Name="Live and final transcript"/>
                        <Border Background="#E8EDF3" Padding="8" Margin="0,8,0,0">
                            <TextBlock Text="{Binding PartialText}" FontStyle="Italic"
                                       Foreground="#4F5965" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Expander>

                <Expander IsExpanded="True" Margin="0,0,0,10">
                    <Expander.Header>
                        <TextBlock Text="Ask Copilot" FontSize="15" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <Border Background="White" BorderBrush="#C8CDD3" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="20,8,4,4">
                        <StackPanel>
                            <TextBlock Text="Paste or type text below, or use the current transcript."
                                       Foreground="#4F5965" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding CopilotPrompt, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="130"
                                     VerticalScrollBarVisibility="Auto" Padding="7"
                                     AutomationProperties.Name="Copilot prompt"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Use Transcript" Command="{Binding UseTranscriptCommand}"
                                        Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="Send to Copilot" Command="{Binding AskCopilotCommand}"
                                        Padding="12,6" Margin="0,0,12,0"/>
                                <CheckBox Content="Read response aloud" IsChecked="{Binding ReadCopilotResponseAloud}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Read Copilot response aloud"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="Copilot response" FontSize="15" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <Grid Margin="20,8,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                        </Grid.RowDefinitions>
                        <Button HorizontalAlignment="Right" Content="Copy Response"
                                Command="{Binding CopyCopilotResponseCommand}" Padding="10,4" Margin="0,0,0,5"/>
                        <Border Grid.Row="1" Background="White" BorderBrush="#ABADB3"
                                BorderThickness="1" Padding="9">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding CopilotResponse}" TextWrapping="Wrap"
                                           AutomationProperties.Name="{Binding CopilotResponse}"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
